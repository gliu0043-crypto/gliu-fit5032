{
  "name": "greenmelbourne-connect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:emulator": "vite --mode emulator --host 127.0.0.1",
    "emulators": "firebase emulators:start --project demo-greenmelbourne --only auth,firestore",
    "test:rules": "node --test tests/firestore.rules.test.mjs",
    "test": "npm run test:tables && firebase emulators:exec --project demo-greenmelbourne --only auth,firestore \"npm run test:rules && node --test tests/auth.integration.test.mjs\"",
    "prebuild": "node scripts/check-config.mjs",
    "deploy": "npm run build && firebase deploy --only firestore:rules,hosting --project fit5032-9edfc",
    "test:tables": "node --test tests/data-table.test.mjs",
    "seed:tables": "node scripts/seed-table-demo.mjs"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "firebase": "^13.0.0",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.2.0"
  }
}
