{
  "name": "greenmelbourne-connect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:emulator": "vite --mode emulator --host 127.0.0.1 --port 5178 --strictPort",
    "emulators": "firebase emulators:start --project demo-greenmelbourne --only auth,firestore",
    "test:rules": "node --test tests/firestore.rules.test.mjs",
    "test": "npm run test:export-statistics && npm run test:tables && npm run test:map && npm run test:email && npm run test:gmail-oauth && firebase emulators:exec --project demo-greenmelbourne --only auth,firestore \"npm run test:rules && node --test tests/auth.integration.test.mjs && npm run test:mail-store\"",
    "prebuild": "node scripts/check-config.mjs",
    "deploy": "npm run build && firebase deploy --only firestore:rules,hosting --project fit5032-9edfc",
    "test:tables": "node --test tests/data-table.test.mjs",
    "seed:tables": "node scripts/seed-table-demo.mjs",
    "test:email": "node --test tests/email.test.mjs",
    "email:dev": "node scripts/email-dev-server.mjs",
    "functions:prepare": "node scripts/prepare-functions.mjs",
    "deploy:email": "firebase deploy --only functions:greenmelbourne:gmcSendActivityEmail --project fit5032-9edfc",
    "test:mail-store": "node scripts/prepare-functions.mjs && node --test tests/mail-store.integration.test.mjs",
    "gmail:authorize": "node scripts/authorize-gmail.mjs",
    "test:gmail-oauth": "node --test tests/gmail-oauth.test.mjs",
    "test:map": "node --test tests/map.test.mjs",
    "test:export-statistics": "node --test tests/export-statistics.test.mjs",
    "test:acceptance": "firebase emulators:exec --project demo-greenmelbourne --only auth,firestore \"npm run test:rules && node --test tests/auth.integration.test.mjs && npm run test:mail-store && npm run seed:tables && playwright test\""
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "canvg": "^4.0.3",
    "chart.js": "^4.5.1",
    "firebase": "^13.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "leaflet": "^1.9.4",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "axe-core": "^4.14.0",
    "nodemailer": "^10.1.0",
    "vite": "^8.2.0"
  }
}
