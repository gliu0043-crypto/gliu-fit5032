rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function organiser() {
      return signedIn() && get(/databases/$(database)/documents/gmcUsers/$(request.auth.uid)).data.role == 'organiser';
    }
    function text(value, min, max) { return value is string && value.size() >= min && value.size() <= max; }
    function validEvent(id) { return id is string && exists(/databases/$(database)/documents/gmcEvents/$(id)); }
    match /gmcUsers/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || organiser());
      allow list: if organiser();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['fullName', 'email', 'role', 'createdAt'])
        && request.resource.data.role == 'member'
        && request.resource.data.email == request.auth.token.email
        && text(request.resource.data.fullName, 1, 100)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName'])
        && text(request.resource.data.fullName, 1, 100);
      // Role assignment is performed only by a trusted project administrator.
      allow delete: if false;
    }
    match /gmcEvents/{eventId} {
      allow read: if true;
      allow write: if organiser();
    }
    match /gmcRegistrations/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || organiser());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId', 'eventId', 'eventTitle', 'fullName', 'email', 'suburb', 'reason', 'status', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'Waiting'
        && validEvent(request.resource.data.eventId)
        && request.resource.data.eventTitle == get(/databases/$(database)/documents/gmcEvents/$(request.resource.data.eventId)).data.title
        && text(request.resource.data.fullName, 2, 100)
        && text(request.resource.data.suburb, 1, 100)
        && text(request.resource.data.reason, 20, 2000)
        && request.resource.data.createdAt == request.time;
      allow update: if organiser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['Waiting', 'Contacted'];
      allow delete: if organiser();
    }
    match /gmcRatings/{id} {
      allow read: if true;
      function validRating() {
        return signedIn()
          && request.resource.data.keys().hasOnly(['userId', 'eventId', 'score', 'reviewerName', 'comment', 'submittedAt', 'updatedAt'])
          && request.resource.data.userId == request.auth.uid
          && validEvent(request.resource.data.eventId)
          && id == request.resource.data.eventId + '_' + request.auth.uid
          && request.resource.data.score is int
          && request.resource.data.score >= 1 && request.resource.data.score <= 5
          && request.resource.data.reviewerName == get(/databases/$(database)/documents/gmcUsers/$(request.auth.uid)).data.fullName
          && text(request.resource.data.comment, 10, 2000)
          && text(request.resource.data.submittedAt, 1, 30)
          && request.resource.data.updatedAt == request.time;
      }
      allow create: if validRating();
      allow update: if validRating() && resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || organiser());
    }
  }
}
